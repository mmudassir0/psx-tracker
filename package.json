{
  "name": "psx-kmi30",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "ingest": "tsx src/scripts/ingest.ts",
    "setup": "node -e \"require('fs').mkdirSync('data',{recursive:true})\" && drizzle-kit push --force && tsx src/scripts/ingest.ts",
    "verify": "tsx src/scripts/verify-parsers.ts",
    "test": "npm run test:portfolio && npm run test:recomposition && npm run test:strategy && npm run test:financials && npm run test:links",
    "test:links": "tsx src/scripts/run-test.ts links",
    "test:portfolio": "tsx src/scripts/run-test.ts portfolio .scratch/test-portfolio.db",
    "test:recomposition": "tsx src/scripts/run-test.ts recomposition .scratch/test-recomposition.db",
    "test:strategy": "tsx src/scripts/run-test.ts strategy .scratch/test-strategy.db",
    "test:financials": "tsx src/scripts/run-test.ts financials",
    "seed:demo": "tsx src/scripts/seed-demo.ts",
    "seed:clear": "tsx src/scripts/seed-demo.ts --clear"
  },
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "better-sqlite3": "^13.0.2",
    "cheerio": "^1.2.0",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.5",
    "typescript": "^5"
  }
}
